<mxfile host="app.diagrams.net" agent="VitaLink" version="24.0.0">
  <diagram name="Fluxo de Dados - VitaLink" id="fluxo-dados-vitalink">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Fronteiras de confianca (retangulos tracejados, desenhados primeiro) -->
        <mxCell id="b_client" value="Fora da fronteira de confianca (cliente)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=6;fillColor=none;strokeColor=#666666;fontColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="380" height="380" as="geometry" />
        </mxCell>
        <mxCell id="b_server" value="Fronteira de confianca (servidor / API)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=6;fillColor=none;strokeColor=#b85450;fontColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="440" y="20" width="320" height="380" as="geometry" />
        </mxCell>
        <mxCell id="b_data" value="Dados (persistencia)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=6;fillColor=none;strokeColor=#666666;fontColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="800" y="20" width="320" height="380" as="geometry" />
        </mxCell>

        <!-- Atores -->
        <mxCell id="n_patient" value="Paciente" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="50" y="60" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n_prof" value="Profissional de Saude" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="50" y="160" width="140" height="60" as="geometry" />
        </mxCell>

        <!-- Aplicacao (processo, cliente) -->
        <mxCell id="n_app" value="Aplicacao Web (interface)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="240" y="110" width="140" height="60" as="geometry" />
        </mxCell>

        <!-- Backend (processos, servidor) -->
        <mxCell id="n_api" value="API REST (processo)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="470" y="60" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n_authn" value="Servico de Autenticacao" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="470" y="160" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n_authz" value="Decisao de Autorizacao" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="470" y="260" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n_audit" value="Registro de Auditoria (processo)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="650" y="330" width="140" height="60" as="geometry" />
        </mxCell>

        <!-- Armazenamento (data stores, cilindros) -->
        <mxCell id="n_db" value="Banco de Dados&#10;(contas, autorizacoes, dados medicos)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="850" y="60" width="140" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n_storage" value="Armazenamento de Documentos" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="850" y="190" width="140" height="90" as="geometry" />
        </mxCell>

        <!-- Servico externo -->
        <mxCell id="n_notify" value="Servico externo de Notificacao (e-mail / SMS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="850" y="330" width="140" height="60" as="geometry" />
        </mxCell>

        <!-- Arestas: acesso do usuario a aplicacao -->
        <mxCell id="e_patient_app" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="n_patient" target="n_app">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_prof_app" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="n_prof" target="n_app">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Aresta que cruza a fronteira de confianca (cliente -> servidor) -->
        <mxCell id="e_app_api" value="HTTPS (todas as requisicoes)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#b85450;fontColor=#b85450;strokeWidth=2;" edge="1" parent="1" source="n_app" target="n_api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- API valida identidade -->
        <mxCell id="e_api_authn" value="valida sessao/token" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" parent="1" source="n_api" target="n_authn">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Fluxos numerados de dados (requisitos 1-5 da Issue #22) -->
        <mxCell id="f1" value="F1 - Solicitacao de acesso (profissional)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;fontColor=#d79b00;" edge="1" parent="1" source="n_api" target="n_authz">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="640" y="90" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="f2" value="F2 - Concessao de autorizacao (paciente)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;fontColor=#d79b00;" edge="1" parent="1" source="n_api" target="n_authz">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="620" y="100" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="f5" value="F5 - Revogacao de autorizacao (paciente)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;fontColor=#b85450;" edge="1" parent="1" source="n_api" target="n_authz">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="600" y="110" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="f3a" value="F3 - Consulta autorizada (dado medico)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;fontColor=#6c8ebf;" edge="1" parent="1" source="n_api" target="n_db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f3b" value="F3 - Consulta autorizada (documento)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;fontColor=#6c8ebf;" edge="1" parent="1" source="n_api" target="n_storage">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f4a" value="F4 - Upload de documento (arquivo)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;fontColor=#82b366;" edge="1" parent="1" source="n_api" target="n_storage">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f4b" value="F4 - Upload de documento (metadados)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;fontColor=#82b366;" edge="1" parent="1" source="n_api" target="n_db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Autorizacao consulta o banco para reavaliar estado -->
        <mxCell id="e_authz_db" value="reavalia estado/escopo/periodo" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;fontSize=10;" edge="1" parent="1" source="n_authz" target="n_db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Fluxo de auditoria (cruza todas as operacoes) -->
        <mxCell id="f6" value="F6 - Registro de auditoria (todas as operacoes F1-F5, sem segredo)" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;fontSize=10;fontColor=#666666;" edge="1" parent="1" source="n_api" target="n_audit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Notificacao externa -->
        <mxCell id="e_api_notify" value="alerta de seguranca" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;fontSize=10;" edge="1" parent="1" source="n_api" target="n_notify">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
